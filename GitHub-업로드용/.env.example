# 공공데이터포털 공통 인증키 (관광정보와 TAGO 등 같은 키를 사용하는 API)
# 사용할 API마다 활용신청 승인이 필요합니다.
# Encoding 키와 Decoding 키 모두 지원합니다. 실제 키가 든 .env는 제출·공유하지 마세요.
DATA_GO_KR_SERVICE_KEY=
# 카카오디벨로퍼스 REST API 키 (차량 전체 경로 예상시간)
KAKAO_REST_API_KEY=
PORT=3000
# 계정 비밀번호 보호용 서버 비밀값. npm run db:local로 로컬 값을 생성합니다.
# Cloudflare에는 동일 이름의 Secret으로 별도 등록합니다. 변경/분실 시 기존 계정 로그인이 불가능해집니다.
AUTH_SECRET=
