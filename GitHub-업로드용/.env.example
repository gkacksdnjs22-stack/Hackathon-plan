# 공공데이터포털 공통 인증키 (관광정보와 TAGO 등 같은 키를 사용하는 API)
# 사용할 API마다 활용신청 승인이 필요합니다.
# Encoding 키와 Decoding 키 모두 지원합니다. 실제 키가 든 .env는 제출·공유하지 마세요.
DATA_GO_KR_SERVICE_KEY=
# 카카오디벨로퍼스 REST API 키 (차량 전체 경로 예상시간)
KAKAO_REST_API_KEY=
PORT=3000
# 계정 비밀번호 보호용 서버 비밀값. npm run db:local로 로컬 값을 생성합니다.
# Cloudflare에는 동일 이름의 Secret으로 별도 등록합니다. 변경/분실 시 기존 계정 로그인이 불가능해집니다.
AUTH_SECRET=
# 소셜 로그인은 아래 설정과 제공자 개발 앱 등록이 끝난 항목만 표시됩니다.
# 사이트 origin만 입력하세요. 로컬과 배포는 각 환경의 주소를 사용합니다.
# 로컬 예: http://localhost:3000 / 배포 예: https://rode-hackathon.pages.dev
SOCIAL_AUTH_BASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 지도·경로 API 키와 별도 설정입니다. 카카오 로그인 활성화 + Client Secret 사용.
KAKAO_LOGIN_CLIENT_ID=
KAKAO_LOGIN_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
